# Environment Variables — Debris Hackathon Prototype
# Copy this file to .env and fill in your real values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/surveillance_db

# JWT (REQUIRED — change before any real deployment)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Admin seed account (created on first boot if no admin exists)
SEED_ADMIN_EMAIL=admin@debris.local
SEED_ADMIN_PASSWORD=Admin@Debris2026!

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=500mb

# CORS - Frontend URL
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# MinIO S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=debris-bucket

# AI Service
AI_SERVICE_URL=http://127.0.0.1:8000

# Twilio SMS (optional — leave blank to disable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
