# AI Service Environment Variables — Debris Hackathon Prototype
# Copy this file to .env inside ai-service/ and fill in your values

# MongoDB
MONGODB_URI=mongodb://localhost:27017/surveillance_db

# Backend API (for webhook callbacks)
BACKEND_API_URL=http://localhost:5000/api

# AI RAG — Groq API Key (required for RAG chat)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for RAG queries
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (HuggingFace)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Debug
DEBUG=False
